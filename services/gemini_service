def analyze_image(image_path: str) -> Dict[str, Any]:
    """
    Analyzes an uploaded image for AI-generation, manipulation, and authenticity.

    Pre-processes the image with the forensic engine to extract objective
    forensic indicators before sending to Gemini. Falls back to local
    heuristics if the API is unavailable.
    """
    if not image_path or not os.path.exists(image_path):
        return error_response("image", "Image file not found.")

    try:
        # Run local forensic pre-processing (always — even in demo mode).
        from services.image_forensics import analyze_image_forensics
        forensic_data = analyze_image_forensics(image_path)
        logger.info("Image forensics extracted: %d indicators", len(forensic_data))

        filename = os.path.basename(image_path)

        if not is_api_available():
            logger.info("Image analysis: running in demo mode (no API key). Forensics still extracted.")
            result = fallback_image_analysis(filename, forensic_data)
            # Merge forensic data into the result.
            for key, value in forensic_data.items():
                if key not in result or not result[key]:
                    result[key] = value
            result["explanation_markdown"] = xai_formatter.format_report(result, "image")
            return result

        prompt = prompt_manager.image_prompt(filename, forensic_data)
        raw = _get_client().generate_with_image(prompt, image_path, "image")
        result = parse_and_validate(raw)

        # Merge forensic data into the result.
        for key, value in forensic_data.items():
            if key not in result or not result[key]:
                result[key] = value

        result["explanation_markdown"] = xai_formatter.format_report(result, "image")
        return result
    except ResponseParseError as exc:
        logger.error("Image analysis parse error: %s", exc)
        return error_response("image", str(exc))
    except Exception as exc:
        logger.error("Image analysis error: %s. Falling back to demo mode.", exc)
        filename = os.path.basename(image_path) if image_path else "unknown"
        try:
            from services.image_forensics import analyze_image_forensics
            forensic_data = analyze_image_forensics(image_path)
        except Exception:
            forensic_data = None
        result = fallback_image_analysis(filename, forensic_data)
        if forensic_data:
            for key, value in forensic_data.items():
                if key not in result or not result[key]:
                    result[key] = value
        result["explanation_markdown"] = xai_formatter.format_report(result, "image")
        return result


def analyze_password(password: str) -> Dict[str, Any]:
    """
    Analyzes a password for strength, entropy, and breach risk.

    SECURITY: Computes anonymized metadata locally and sends ONLY the
    metadata to Gemini — the raw password never leaves the server.
    Falls back to local heuristics if the API is unavailable.
    """
    if not password:
        return error_response("password", "Password input is empty.")

    # Compute password metadata locally (always — for both Gemini and fallback).
    metadata = compute_password_metadata(password)
    logger.info("Password metadata computed: length=%d, entropy=%d, risk=%s", metadata["length"], metadata["entropy"], metadata["risk"])

    if not is_api_available():
        logger.info("Password analysis: running in demo mode (no API key).")
        result = fallback_password_analysis(password)
        result["explanation_markdown"] = xai_formatter.format_report(result, "password")
        return result

    try:
        # Send ONLY anonymized metadata to Gemini — never the raw password.
        prompt = prompt_manager.password_prompt(metadata)
        raw = _get_client().generate_text(prompt, "password")
        result = parse_and_validate(raw)

        # Ensure locally computed metadata is preserved in the result.
        result["entropy"] = metadata["entropy"]
        result["has_uppercase"] = metadata["has_uppercase"]
        result["has_lowercase"] = metadata["has_lowercase"]
        result["has_digit"] = metadata["has_digit"]
        result["has_special"] = metadata["has_special"]
        result["estimated_crack_time"] = metadata["estimated_crack_time"]

        result["explanation_markdown"] = xai_formatter.format_report(result, "password")
        return result
    except ResponseParseError as exc:
        logger.error("Password analysis parse error: %s", exc)
        return error_response("password", str(exc))
    except Exception as exc:
        logger.error("Password analysis error: %s. Falling back to demo mode.", exc)
        result = fallback_password_analysis(password)
        result["explanation_markdown"] = xai_formatter.format_report(result, "password")
        return result


def get_security_advice(profile: Dict[str, Any]) -> Dict[str, Any]:
    """
    Processes a personal security posture questionnaire using Gemini AI.
    Falls back to local heuristics if the API is unavailable.
    """
    if not profile:
        return error_response("advisor", "Security profile is empty.")

    if not is_api_available():
        logger.info("Advisor analysis: running in demo mode (no API key).")
        result = fallback_advisor_analysis(profile)
        result["general_advisor_markdown"] = xai_formatter.format_report(result, "advisor")
        return result

    try:
        prompt = prompt_manager.advisor_prompt(profile)
        raw = _get_client().generate_text(prompt, "advisor")
        result = parse_and_validate(raw)
        result["general_advisor_markdown"] = xai_formatter.format_report(result, "advisor")
        return result
    except ResponseParseError as exc:
        logger.error("Advisor analysis parse error: %s", exc)
        return error_response("advisor", str(exc))
    except Exception as exc:
        logger.error("Advisor analysis error: %s. Falling back to demo mode.", exc)
        result = fallback_advisor_analysis(profile)
        result["general_advisor_markdown"] = xai_formatter.format_report(result, "advisor")
        return result


def chat(message: str, history: Optional[List[Dict[str, str]]] = None) -> str:
    """
    Processes a cybersecurity assistant chat message using Gemini AI.
    Falls back to local keyword-based responder if the API is unavailable.
    """
    if not message or not message.strip():
        return "I didn't receive a message. Please ask a cybersecurity question and I'll help you."

    if not is_api_available():
        logger.info("Chat: running in demo mode (no API key).")
        return fallback_chat_response(message)

    try:
        prompt = prompt_manager.chat_prompt(message, history)
        raw = _get_client().generate_chat(prompt, "chat")
        return raw.strip()
    except Exception as exc:
        logger.error("Chat error: %s. Falling back to demo mode.", exc)
        return fallback_chat_response(message)


