SECRET_KEY=your-secret-key

JWT_SECRET_KEY=your-jwt-secret

# Leave this as SQLite for local runs.
# On Render, either delete DATABASE_URL or set it to the Aiven Service URI:
# mysql://USER:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED
# Do not commit the real URI. The app converts mysql:// to mysql+pymysql:// and uses SSL_CA.
DATABASE_URL=sqlite:///cybershield.db

UPLOAD_FOLDER=uploads

GEMINI_API_KEY=your-gemini-api-key

GEMINI_MODEL=gemini-3.8-flash

TEMPERATURE=0.2

MAX_OUTPUT_TOKENS=8192

TIMEOUT=60

DB_HOST=mysql-23e05a00-kamiyabali50-f0f9.e.aivencloud.com
DB_PORT=11781
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-db-password

SSL_CA=certs/ca.pem
